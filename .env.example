# Environment variables for the storefront. Copy to .env for local dev.
# Set the same names in Vercel -> Project -> Settings -> Environment Variables.

# --- Interest / contact form endpoint ---
# Create a free form at https://formspree.io, copy its endpoint URL here.
VITE_FORM_ENDPOINT="https://formspree.io/f/your-form-id"

# --- Store contact email ---
# Verified email address displayed in the contact card.
VITE_CONTACT_EMAIL=""

# --- Production error monitoring (Sentry, optional) ---
VITE_SENTRY_DSN=""
