# Environment variables for the storefront. Copy to `.env` for local dev, and
# set the same names in Vercel → Project → Settings → Environment Variables.
# Nothing here is a secret in code — the app reads these at build time.

# --- Interest / contact form endpoint (contact-form feature) ---
# Create a free form at https://formspree.io, copy its endpoint URL here.
# The form shows an on-screen error until this is set.
VITE_FORM_ENDPOINT="https://formspree.io/f/your-form-id"

# --- Booking / calendar link (contact-only CRM) ---
# Paste a Calendly, Cal.com, or similar scheduling link here. Until set, the
# contact card shows a placeholder.
VITE_BOOKING_HREF=""

# --- Store contact details ---
# These render in the contact-only CRM card. No secrets.
VITE_CONTACT_EMAIL="hello@lanybooks.com"
VITE_CONTACT_PHONE="(555) 123-4567"

# --- Production error monitoring (Sentry) ---
# Create a project at https://sentry.io, copy its DSN here.
# Monitoring is completely inert (no-op) until this is set, and only reports
# from real deployed builds — never from local dev.
VITE_SENTRY_DSN=""
